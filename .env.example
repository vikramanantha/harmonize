# ---- Muse login (Browserbase runs the browser) ----
BROWSERBASE_API_KEY=
# Required for contexts (persistent Muse logins). From the Browserbase dashboard settings.
BROWSERBASE_PROJECT_ID=
# Optional overrides if Muse changes its authenticated chat controls.
MUSE_PROMPT_SELECTOR=
MUSE_SEND_SELECTOR=

# ---- Harmony server ----
# Public URL of this server. Muse (in Meta's cloud) calls it back here, so it must
# be reachable from the internet, e.g. an ngrok URL.
SERVER_PUBLIC_URL=
DB_PATH=./data/harmony.sqlite

# Shared SpacetimeDB (anonymous access, so nothing private is stored there).
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=harmony-1o7k0

# Similarity service: semantic/run.sh
SEMANTIC_URL=http://127.0.0.1:8008

# Matching hyperparameters
MATCH_THRESHOLD=0.8
LOOP=false
PROXIMITY_WINDOW_MS=10000
ENCOUNTER_COOLDOWN_MS=3600000
MUSE_CALLBACK_TIMEOUT_MS=1200000
SUMMARY_REFRESH_MS=86400000

# Lets any signed-in phone run "Reset demo" in developer mode (clears who has
# been texted, for everyone). Set to false outside of demos.
DEMO_RESET=true

# ---- Photon (iMessage) ----
# NOTIFIER=photon sends real iMessages; NOTIFIER=log only prints them.
NOTIFIER=photon
# From https://app.photon.codes/ -> project Settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# ---- Testing without Muse ----
# true: POST /api/app/login/start accepts {identifier, phone_number, consent, mock_username}
# and logs in immediately, provided a taste_profile row for mock_username exists.
MOCK_MUSE=false
